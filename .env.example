# Settings for the server (apps/server). Copy to .env, which git ignores, and start it with
#   node --env-file=.env apps/server/src/main.ts
# The container image sets HOST, PORT, DATA_DIR and RENDER_SANDBOX itself. A value that does not parse stops the
# server at startup. Commented values are the defaults.

# Where it listens. Any HOST but loopback needs API_TOKENS, or ALLOW_ANONYMOUS_API=1 behind a proxy that authenticates.
HOST=127.0.0.1
PORT=3000
# Decks, their versions and cached renders
DATA_DIR=./data

# Bearer tokens for /api (all but /api/health): comma-separated, 32 characters or more each (openssl rand -hex 32)
API_TOKENS=
# ALLOW_ANONYMOUS_API=1
# Proxies whose X-Forwarded-For names the client: a hop count (1 behind one load balancer), true, or addresses/CIDRs
# TRUST_PROXY=1
# The built editor, served at / (default: apps/web/dist)
# WEB_DIR=

# Limits
# MAX_UPLOAD_MB=100
# MAX_INFLATED_MB=512
# RATE_LIMIT=600              requests per minute per client; uploads get a tenth; 0 turns it off
# WORKERS=                    parser threads (default: 1 or 2, by CPU count)
# WORKER_HEAP_MB=512
# PARSE_TIMEOUT_MS=20000
# RENDER_PAGES=2              Chromium pages drawing at once; 0 turns slide images and PDFs off
# RENDER_TIMEOUT_MS=30000
# RENDER_SANDBOX=0            only where Chromium's sandbox cannot start (containers)
# LOG_LEVEL=info

# The CI oracles (see README.md): off unless ENABLE_ORACLES=1
# ENABLE_ORACLES=1
# PPTX_VALIDATOR=["dotnet", "run", "--project", "tools/validator", "--"]
# POWERPOINT_BRIDGE_URL=http://windows-runner:8080/
