node_modules/
# third-party test decks and their download cache (corepack pnpm corpus:fetch)
corpus/external
corpus/.cache/
# your own decks, for the local end-to-end tests (tools/render/decks.test.ts): never committed
corpus/local/
# renders, reports and logs from the tools
out/
# the server's decks, their versions and renders when it runs here (npm start; DATA_DIR defaults to ./data)
data/
# build output: the editor (apps/web/dist) and the server's render page (apps/server/dist)
dist/
*.tsbuildinfo
# local configuration and secrets
.env
.env.*
!.env.example
# Claude Code worktrees and personal settings
.claude/worktrees/
.claude/settings.local.json
.DS_Store
